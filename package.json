{
  "name": "xquiz",
  "version": "1.0.0",
  "description": "Chrome extension that tests your attention and retention while scrolling Twitter/X",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Rishabh Ranawat",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:safari": "node scripts/build.mjs --target=safari",
    "watch": "node scripts/build.mjs --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "adm-zip": "^0.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
